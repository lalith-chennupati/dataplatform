{
 "title": "AI Factory infrastructure health (SIM)",
 "uid": "aif-infra",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Firing alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Mean GPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "gauge",
   "title": "Storage quota used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(storage_quota_used_ratio)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Back-end links up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(fabric_link_oper_up)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "GPU temperature",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_GPU_TEMP",
     "legendFormat": "gpu {{gpu}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "GPU SM clock",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "hertz"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_SM_CLOCK",
     "legendFormat": "gpu {{gpu}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Node power (iDRAC)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redfish_power_consumed_watts",
     "legendFormat": "{{node}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "PFC pause frames",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(fabric_pfc_pause_frames_total[1m])",
     "legendFormat": "{{port}}"
    }
   ]
  }
 ]
}