#!/usr/bin/env bash
# AWS CLI against the lab S3 endpoint. Usage: S3_USER=finance bin/s3 s3 ls s3://bu-finance
# Mounts the current directory at /work so local files can be uploaded (e.g. bin/s3 s3 cp /work/file s3://bucket/).
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
set -a; . "$here/.env"; set +a
user="${S3_USER:-labadmin}"
case "$user" in
  labadmin) key="$S3_ACCESS_KEY"; secret="$S3_SECRET_KEY" ;;
  *) key="$user"; secret="${user}-secret" ;;
esac
exec docker run --rm -i --network aifactory-lab_default -v "$PWD:/work" -w /work \
  -e AWS_ACCESS_KEY_ID="$key" -e AWS_SECRET_ACCESS_KEY="$secret" -e AWS_REGION="$S3_REGION" \
  -e AWS_REQUEST_CHECKSUM_CALCULATION=when_required -e AWS_RESPONSE_CHECKSUM_VALIDATION=when_required \
  "${REGISTRY:-mirror.gcr.io}/amazon/aws-cli:2.27.0" --endpoint-url "${S3_ENDPOINT:-http://s3:8333}" "$@"
